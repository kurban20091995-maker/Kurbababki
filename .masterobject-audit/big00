+fun Long.asRubles(): String {
+    val negative = this < 0
+    val value = if (negative) -this else this
+    val major = "%,d".format(value / 100).replace(',', ' ')
+    val minor = (value % 100).toString().padStart(2, '0')
+    val amount = if (minor == "00") major else "$major,$minor"
+    return (if (negative) "-" else "") + amount + " ₽"
+}
+fun Double.toHalfDays(): Int = kotlin.math.round(this * 2.0).toInt().coerceAtLeast(1)
