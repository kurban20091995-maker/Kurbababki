+package ru.furniturecrm.app
+
+import java.time.Instant
+import java.time.LocalDate
+import java.time.LocalDateTime
+import java.time.LocalTime
+import java.time.ZoneId
+import java.time.ZonedDateTime
+
+/**
+ * Single source of truth for all business dates in the CRM.
+ * The installer works in Moscow/Dagestan time (UTC+3), so calculations must not
+ * silently change when the phone, VPN or cloud environment uses another zone.
+ */
+object BusinessTime {
+    const val ZONE_ID = "Europe/Moscow"
+    val zoneId: ZoneId = ZoneId.of(ZONE_ID)
+
+    fun now(): ZonedDateTime = ZonedDateTime.now(zoneId)
+    fun today(): LocalDate = now().toLocalDate()
+    fun time(): LocalTime = now().toLocalTime()
+    fun localDateTime(): LocalDateTime = now().toLocalDateTime()
+
+    fun dateAt(instant: Instant): LocalDate = instant.atZone(zoneId).toLocalDate()
+    fun timeAt(instant: Instant): LocalTime = instant.atZone(zoneId).toLocalTime()
+
+    /** Changes only when the planning half-day or calendar date changes. */
+    fun planningKey(): String {
+        val now = now()
+        val half = when {
+            now.toLocalTime() >= LocalTime.of(19, 0) -> 2
+            now.toLocalTime() >= LocalTime.of(13, 0) -> 1
+            else -> 0
+        }
+        return "${now.toLocalDate()}-$half"
+    }
+}
